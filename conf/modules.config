/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process.errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
process {

    array = 0  // Disable job arrays globally to avoid ConcurrentModificationException

    withName: 'NOVOINDEX' {
        // container = "sachet/polysolver:v4"
        publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
            mode: 'copy',
            pattern: "*.nix"
        ]
        cpus = 2
        memory = '16.GB'
        time = '2.h'
        
        // Index-specific arguments
        ext.args = '-k 14 -s 2'  // Recommended for human genome
    }
    
    withName: 'NOVOALIGN' {
        // container = "sachet/polysolver:v4"

        publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
            mode: 'copy',
            pattern: "*.bam"
        ]
        cpus = 2
        memory = '16.GB'
        time = '4.h'
        
        // Alignment-specific arguments
        // ext.args = '-R 0 -r all'  // Critical Polysolver parameters for HLA multi-mapping
        ext.args = '-R 0 -t 120 -r Exhaustive 10'  // Critical Polysolver parameters for HLA multi-mapping
        
        // Note: Read groups are added automatically by samtools addreplacerg in the module

        // Alignment mode - choose one:
        ext.soft_clip = false  // Use Polysolver default (FullNW, no soft-clipping)
        // OR
        // ext.soft_clip = true  // Use Polysolver soft-clip mode (-g 20 -x 3)

        // BAM conversion arguments
        ext.samtools_args = '-b -h -F 4'  // Keep this - excludes unmapped reads
    }

    // publishDir = [
    //     path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '').replace('_somatic', '')}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/" },
    //     mode: params.publish_dir_mode,
    //     saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    // ]

    withName: FASTQC {
        ext.args = '--quiet'
    }
    
    withName: BWA_MEM {
            // cache=false
            scratch=true
            ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:${meta.id}'" }
            // publishDir = [
            //     path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
            //     mode: "link",
            //     saveAs: { filename -> 
            //         if (filename.equals('versions.yml')) {
            //             return null  // Don't publish this file
            //         } else if (filename.endsWith('.bam')) {
            //             return "output/${filename}"  // Publish to subdirectory
            //         }
            //     }
            // ]
            // storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/" }
            cpus   = { 4      * task.attempt }
            memory = { 4.GB   * task.attempt }
            time   = { 4.h    * task.attempt }
    }

    withName: BWA_INDEX {
            // ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:${meta.id}'" }
            // storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/" }   
            cache=false
            publishDir = [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                saveAs: { filename -> 
                    if (filename.equals('versions.yml')) {
                        return null  // Don't publish this file
                    } else if (filename.endsWith('.bai')) {
                        return "output/${filename}"  // Publish to subdirectory
                    }
                }
            ]
    }

    withName: SAMTOOLS_FAIDX {
            // ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:${meta.id}'" }
            // storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/" }   
            // cache=false
            publishDir = [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                saveAs: { filename -> 
                    if (filename.equals('versions.yml')) {
                        return null  // Don't publish this file
                    } else if (filename.endsWith('.bai')) {
                        return "output/${filename}"  // Publish to subdirectory
                    }
                },
                enabled: false
            ]
    }
    withName: SAMTOOLS_INDEX {
            // ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:${meta.id}'" }
            // storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/" }   
            // cache=false
            publishDir = [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                saveAs: { filename -> 
                    if (filename.equals('versions.yml')) {
                        return null  // Don't publish this file
                    } else if (filename.endsWith('.bai')) {
                        return "output/${filename}"  // Publish to subdirectory
                    }
                },
                enabled: false
            ]
    }


    withName: EXTRACT_HLA_REGION {
        // Extract HLA region from WGS/WES BAMs before FASTQ conversion (POLYSOLVER approach)
        // Default: Extract entire MHC region chr6:28000000-34000000 (hg38)
        // For hg19/GRCh37, use: ext.hla_region = '6:28000000-34000000'
        // ext.hla_region = 'chr6:28000000-34000000'  // hg38 coordinates
        ext.hla_region = '6:28000000-34000000'
        ext.use_specific_genes = false  // Set true to use only HLA-A/B/C loci

        publishDir = [
            [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                pattern: "*.hla_region.bam*",
                saveAs: { filename -> "hla_region_bams/${filename}" },
                enabled: false  // Set to true if you want to keep these intermediate BAMs
            ],
            [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                pattern: "*.hla_stats.txt",
                saveAs: { filename -> "qc/${filename}" }
            ]
        ]
    }

    withName: SAMTOOLS_FASTQ {
            ext.args = { "-N" }
            scratch=true
            storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/${meta.id}/" }

            publishDir = [
                path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
                mode: "link",
                saveAs: { filename ->
                    if (filename.equals('versions.yml')) {
                        return null  // Don't publish this file
                    } else if (filename.endsWith('.vcf.gz')) {
                        return "mutect2/${filename}"  // Publish to subdirectory
                    } else if (filename.endsWith('.stats')) {
                        return "mutect2/${filename}"  // Publish to subdirectory
                    }
                    // else {
                    //     return filename  // Publish with original name
                    // }
                },
                enabled: false
            ]
    }


    withName: GATK4_CREATESEQUENCEDICTIONARY {
            // cache=false
            // ext.args = { "-normal ${meta.normal_id}" }
            publishDir = [
                path: { "${params.outdir}/" },
                mode: "link",
                enabled: false
            ]
    }


    withName: GATK4_MUTECT2 {
            // cache=false
            ext.args = { "-normal ${meta.normal_id}" }
            publishDir = [
                path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
                mode: "link",
                saveAs: { filename -> 
                    if (filename.equals('versions.yml')) {
                        return null  // Don't publish this file
                    } else if (filename.endsWith('.vcf.gz')) {
                        return "mutect2/${filename}"  // Publish to subdirectory
                    } else if (filename.endsWith('.stats')) {
                        return "mutect2/${filename}"  // Publish to subdirectory
                    } 
                    // else {
                    //     return filename  // Publish with original name
                    // }
                }
            ]
    }

    withName: SomaticCombineChannel {
            publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
            mode: "link",
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('.vcf.gz')) {
                    return "output//${filename}"  // Publish to subdirectory
                }
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }

    withName: GATK4_FILTERMUTECTCALLS {
            // cache=false
            publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
            mode: "link",
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('.vcf.gz')) {
                    return "mutect2/${filename}"  // Publish to subdirectory
                } else if (filename.endsWith('.stats')) {
                    return "mutect2/${filename}"  // Publish to subdirectory
                } 
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }

    withName: STRELKA_SOMATIC {
            ext.args="--config=${projectDir}/assets/configureStrelkaSomaticWorkflow.py.ini"
            // cache=false
            publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
            mode: "link",
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('.vcf.gz')) {
                    return "strelka/${filename}"  // Publish to subdirectory
                } 
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }

    withName: HLAHD {
            scratch=true
            // cache=false
            storeDir = { "${params.outdir}/storeDir/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}/${meta.id}/" }   
            publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '')}/" },
            mode: "link",
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('final.result.txt')) {
                    return "HLAHD/${filename}"  // Publish to subdirectory
                } 
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }

    withName: HLA_FROM_SAMPLESHEET {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) { return null }
                else if (filename.endsWith('_final.result.txt')) { return "hla_from_samplesheet/${filename}" }
                else { return null }
            }
        ]
    }

    withName: HAPSTER {
        scratch = true
        cpus = { 8 * task.attempt }
        memory = { 48.GB * task.attempt }
        time = { 24.h * task.attempt }

        ext.protocol = 'wgs'
        ext.genes = 'A,B,C'

        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/" },
                mode: "link",
                pattern: "*/somatic/*.vcf.gz*",
                saveAs: { filename -> "hapster/somatic/${file(filename).name}" }
            ],
            [
                path: { "${params.outdir}/${meta.id}/" },
                mode: "link",
                pattern: "*/somatic/*.annotated.txt",
                saveAs: { filename -> "hapster/somatic/${file(filename).name}" }
            ],
            [
                path: { "${params.outdir}/${meta.id}/" },
                mode: "link",
                pattern: "*/germline/*.vcf.gz*",
                saveAs: { filename -> "hapster/germline/${file(filename).name}" }
            ],
            [
                path: { "${params.outdir}/${meta.id}/" },
                mode: "link",
                pattern: "*/haplotypes/*",
                saveAs: { filename -> "hapster/haplotypes/${file(filename).name}" }
            ]
        ]
    }

    withName: CREATE_HLA_REFERENCE{
        // cache=false
        publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '')}/" },
            mode: "link",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('fasta')) {
                    return "hlaref/${filename}"  // Publish to subdirectory
                }
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }

    withName: PARSE_HLA_ALLELES {
        publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '')}/" },
            mode: "link",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('.txt')) {
                    return "alleles/${filename}"  // Publish to subdirectory
                }
            }
        ]
    }

    withName: EXTRACT_ALLELE_BAM {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
            mode: "link",
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('.bam') || filename.endsWith('.bai')) {
                    return "allele_bams/${filename}"  // Publish to subdirectory
                }
            }
        ]
    }

    withName: FILTER_ALLELE_BAM {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
        // POLYSOLVER-style event count filtering
        // Filters reads with excessive mismatches/indels (likely paralog contaminants)
        // Reads aligned to personalized HLA alleles should have very low NM values;
        // paralog reads from HLA-E/F/G/pseudogenes typically have NM > 5
        ext.max_events = 3  // Maximum allowed mismatches + insertions + deletions
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                pattern: "*.filtered.bam*",
                saveAs: { filename -> "allele_bams_filtered/${filename}" }
            ],
            [
                path: { "${params.outdir}/${meta.id.replace('_normal', '').replace('_tumor', '')}/" },
                mode: "link",
                pattern: "*.filter_stats.txt",
                saveAs: { filename -> "qc/${filename}" }
            ]
        ]
    }

    withName: COMBINE_ALLELE_VCFS {
        // Combines per-allele VCFs into per-sample VCFs
        // Preserves allele information in HLA_ALLELE INFO field
        publishDir = [
            [
                path: { "${params.outdir}/${meta.sample_id}/" },
                mode: "link",
                pattern: "*.combined.vcf.gz*",
                saveAs: { filename -> "combined_vcfs/${filename}" }
            ],
            [
                path: { "${params.outdir}/${meta.sample_id}/" },
                mode: "link",
                pattern: "*.stats.txt",
                saveAs: { filename -> "qc/${filename}" }
            ]
        ]
    }

    withName: GENOMENEXUS_VCF2MAF {
            publishDir = [
            path: { "${params.outdir}/${meta.id.replace('_somatic', '')}/" },
            mode: "link",
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null  // Don't publish this file
                } else if (filename.endsWith('maf')) {
                    return "output/${filename}"  // Publish to subdirectory
                }
                // else {
                //     return filename  // Publish with original name
                // }
            }
        ]
    }



    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
